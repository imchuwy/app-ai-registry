{
  "name": "oc-ai-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "check": "npm run check:design && npm run typecheck && npm run lint && npm test && npm run build",
    "check:design": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
